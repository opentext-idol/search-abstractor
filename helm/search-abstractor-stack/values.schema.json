{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "aes": {
      "properties": {
        "key": {
          "$ref": "#/$defs/required_string"
        }
      },
      "required": [
        "key"
      ],
      "type": "object"
    },
    "auth": {
      "allOf": [
        {
          "$ref": "#/$defs/optional_object"
        }
      ],
      "properties": {
        "additionalSecrets":{
            "type":"object",
            "patternProperties": {
                ".+": {
                    "type": "string"
                }
            }
        },
        "apiClient": {
          "type": "string"
        },
        "apiClientSecret": {
          "type": "string"
        },

        "createAdminPassword": {
          "type": "string"
        },
        "createAdminUsername": {
          "type": "string"
        },
        "external":{
            "type":"object",
            "properties":{
                "host":{
                    "type":"string"
                },
                "port":{
                    "type":"integer"
                },
                "protocol":{
                    "type":"string"
                }
            },
            "required":["host","port","protocol"],
            "unevaluatedProperties": false
        },
        "initEnabled": {
          "type": "boolean"
        },
        "ogsClient": {
          "type": "string"
        },
        "ogsClientSecret": {
          "type": "string"
        },
        "otdsws": {
          "type": "object"
        },
        "partition": {
          "type": "string"
        },
        "refreshTokenExpiryTimeSeconds": {
          "type": "integer"
        },
        "simplePasswordPolicy": {
          "type": "boolean"
        },
        "tokenExpiryTimeSeconds": {
          "type": "integer"
        },
        "uiClient": {
          "type": "string"
        },
        "uiUrls": {
          "type": "string"
        },
        "userSecurity": {
          "$ref": "#/$defs/userSecurity"
        },
        "users":{
            "type": "object",
            "patternProperties": {
                ".+": {
                    "type": "object",
                    "properties": {
                        "passwordEnv": {
                            "type": "string"
                        },
                        "passwordTemporary": {
                            "type": "boolean"
                        }
                    },
                    "required": ["passwordEnv"]
                }
            }
        }
      },
      "required": [
        "apiClient",
        "apiClientSecret",
        "initEnabled",
        "partition",
        "tokenExpiryTimeSeconds",
        "uiClient",
        "uiUrls"
      ],
      "type": "object"
    },
    "base": {
      "properties": {
        "aes": {
          "$ref": "#/$defs/aes"
        },
        "answerserver": {
          "$ref": "#/$defs/optional_object"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "community": {
          "$ref": "#/$defs/community"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "distributedidol": {
          "$ref": "#/$defs/distributedidol"
        },
        "ext": {
          "type": "object"
        },
        "global": {
          "$ref": "#/$defs/global"
        },
        "idol-library": {
          "type": "object"
        },
        "llavadeployment": {
          "$ref": "#/$defs/optional_object"
        },
        "nifi": {
          "$ref": "#/$defs/optional_object"
        },
        "ogs": {
          "$ref": "#/$defs/ogs"
        },
        "otdsdb": {
          "$ref": "#/$defs/optional_object"
        },
        "qms": {
          "$ref": "#/$defs/optional_object"
        },
        "saapi": {
          "$ref": "#/$defs/saapi"
        },
        "saapiPostgresql": {
          "$ref": "#/$defs/saapiPostgresql"
        },
        "view": {
          "$ref": "#/$defs/optional_object"
        },
        "vllmdeployment": {
          "$ref": "#/$defs/optional_object"
        }
      },
      "required": [
        "aes",
        "answerserver",
        "auth",
        "community",
        "content",
        "distributedidol",
        "global",
        "llavadeployment",
        "nifi",
        "ogs",
        "qms",
        "saapi",
        "saapiPostgresql",
        "view",
        "vllmdeployment"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "community": {
      "allOf": [
        {
          "$ref": "#/$defs/optional_object"
        }
      ],
      "properties": {
        "cfg": {
          "properties": {
            "otds": {
              "type": "string"
            },
            "overwrite": {
              "type": "boolean"
            },
            "security": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "content": {
      "allOf": [
        {
          "$ref": "#/$defs/optional_object"
        }
      ],
      "properties": {
        "cfg": {
          "properties": {
            "fieldprocessing": {
              "type": "string"
            },
            "security": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "distributedidol": {
      "allOf": [
        {
          "$ref": "#/$defs/optional_object"
        }
      ],
      "properties": {
        "content": {
          "type": "object"
        },
        "dah": {
          "type": "object"
        },
        "dih": {
          "type": "object"
        }
      },
      "required": [
        "content",
        "dah",
        "dih"
      ],
      "type": "object"
    },
    "global": {
      "properties": {
        "idolVersion": {
          "type": "string"
        },
        "imagePullSecrets": {
          "items": {
            "$ref": "#/$defs/required_string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "imagePullSecrets"
      ],
      "type": "object"
    },
    "google_auth_mode": {
      "enum": [
        "serviceAccount",
        "credentials"
      ],
      "type": "string"
    },
    "image": {
      "properties": {
        "pullPolicy": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "pullPolicy",
        "registry",
        "repo",
        "version"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "ogs": {
      "allOf": [
        {
          "$ref": "#/$defs/optional_object"
        }
      ],
      "properties": {
        "cfg": {
          "properties": {
            "otds": {
              "type": "string"
            },
            "overwrite": {
              "type": "boolean"
            },
            "repositories": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "optional_object": {
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "otdsdb": {
      "$ref": "#/$defs/optional_object"
    },
    "required_string": {
      "minLength": 1,
      "type": "string"
    },
    "resources": {
      "$ref": "#/$defs/optional_object"
    },
    "saapi": {
      "properties": {
        "additionalVolumeMounts": {
          "type": "object"
        },
        "additionalVolumes": {
          "type": "object"
        },
        "allowedOrigins": {
          "type": "string"
        },
        "backendIdolAnswerServerHost": {
          "$ref": "#/$defs/required_string"
        },
        "backendIdolAnswerServerPort": {
          "$ref": "#/$defs/required_string"
        },
        "backendIdolAnswerServerSystemOrdering": {
          "$ref": "#/$defs/required_string"
        },
        "backendIdolContentHost": {
          "$ref": "#/$defs/required_string"
        },
        "backendIdolContentPort": {
          "$ref": "#/$defs/required_string"
        },
        "backendIdolViewHost": {
          "$ref": "#/$defs/required_string"
        },
        "backendIdolViewPort": {
          "$ref": "#/$defs/required_string"
        },
        "backendIdolHost": {
          "$ref": "#/$defs/required_string"
        },
        "backendIdolPort": {
          "$ref": "#/$defs/required_string"
        },
        "config": {
          "$ref": "#/$defs/required_string"
        },
        "httpCacheMaxAge": {
          "minimum": 1,
          "type": "integer"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "ingress": {
          "properties": {
            "className": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "path": {
              "$ref": "#/$defs/required_string"
            },
            "port": {
              "type": "integer"
            }
          },
          "required": [
            "className",
            "host",
            "port",
            "path"
          ],
          "type": "object",
          "unevaluatedProperties": false
        },
        "javaOpts": {
          "type": "string"
        },
        "management": {
            "type": "object",
            "properties": {
                "basePath": {
                    "type": "string"
                }
            },
            "required": ["basePath"],
            "unevaluatedProperties": false
        },
        "metadataPromptFile": {
          "$ref": "#/$defs/required_string"
        },
        "name": {
          "$ref": "#/$defs/required_string"
        },
        "replicas": {
          "type": "integer"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "rewriteQueries": {
          "type": "boolean"
        },
        "secret": {
          "$ref": "#/$defs/required_string"
        },
        "security":{
            "type":"object",
            "properties":{
                "trustedCertsPath":{
                    "type":"string"
                }
            },
            "required":["trustedCertsPath"],
            "unevaluatedProperties": false
        },
        "service": {
          "properties": {
            "name": {
              "$ref": "#/$defs/required_string"
            },
            "port": {
              "type": "integer"
            }
          },
          "required": [
            "name",
            "port"
          ],
          "type": "object"
        },
        "storage": {
          "properties": {
            "dbName": {
              "$ref": "#/$defs/required_string"
            },
            "maxFileSize": {
              "$ref": "#/$defs/required_string"
            },
            "maxRequestSize": {
              "$ref": "#/$defs/required_string"
            }
          },
          "required": [
            "dbName",
            "maxFileSize",
            "maxRequestSize"
          ],
          "type": "object",
          "unevaluatedProperties": false
        },
        "usingDiscoverIndex": {
          "type": "boolean"
        },
        "llama": {
          "properties": {
            "apiKey": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "endpointBase": {
              "$ref": "#/$defs/required_string"
            },
            "hfModel": {
              "$ref": "#/$defs/required_string"
            },
            "modelRevision": {
              "type": "string"
            },
            "hfToken": {
              "type": "string"
            },
            "model": {
              "$ref": "#/$defs/required_string"
            },
            "multimodal": {
              "type": "boolean"
            }
          }
        },
        "vertexai": {
          "properties": {
            "authentication": {
              "$ref": "#/$defs/google_auth_mode"
            },
            "credentials": {
              "type": "object"
            },
            "enabled": {
              "type": "boolean"
            },
            "location": {
              "type": "string"
            },
            "maxOutputTokens": {
              "type": "integer"
            },
            "model": {
              "type": "string"
            },
            "project": {
              "type": "string"
            }
          },
          "required": [
            "authentication",
            "enabled"
          ],
          "type": "object",
          "unevaluatedProperties": false
        },
        "vllm": {
          "properties": {
            "HFToken": {
              "type": "string"
            },
            "chatEndpoint": {
              "$ref": "#/$defs/required_string"
            },
            "endpoint": {
              "$ref": "#/$defs/required_string"
            },
            "llavaEndpointBase": {
              "$ref": "#/$defs/required_string"
            },
            "llavaModel": {
              "type": "string"
            },
            "model": {
              "$ref": "#/$defs/required_string"
            },
            "modelRevision": {
              "type": "string"
            },
            "openAiApiKey": {
              "type": "string"
            }
          },
          "required": [
            "chatEndpoint",
            "endpoint",
            "model",
            "llavaEndpointBase",
            "llavaModel"
          ],
          "type": "object",
          "unevaluatedProperties": false
        },
        "sessionLicensor": {
          "properties": {
            "name": {
              "$ref": "#/$defs/required_string"
            },
            "port": {
              "type": "integer"
            }
          },
          "required": [
            "name",
            "port"
          ],
          "type": "object",
          "unevaluatedProperties": false
        }
      },
      "required": [
        "allowedOrigins",
        "backendIdolContentHost",
        "backendIdolContentPort",
        "backendIdolHost",
        "backendIdolPort",
        "config",
        "httpCacheMaxAge",
        "image",
        "ingress",
        "management",
        "name",
        "replicas",
        "resources",
        "secret",
        "security",
        "service",
        "storage",
        "usingDiscoverIndex",
        "vllm",
        "sessionLicensor"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "saapiPostgresql": {
      "$ref": "#/$defs/optional_object"
    },
    "userSecurity": {
      "properties": {
        "repository": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$ref": "#/$defs/base",
  "type": "object",
  "unevaluatedProperties": false
}
